<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AtvBreak" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- 主按钮：实心主色 -->
    <style name="AtvButton" parent="android:Widget.DeviceDefault.Button">
        <item name="android:minWidth">176dp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:background">@drawable/bg_button</item>
    </style>

    <!-- 次级按钮：描边幽灵按钮 -->
    <style name="AtvButton.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>

    <!-- 预设胶囊 -->
    <style name="AtvChip" parent="android:Widget.DeviceDefault.Button">
        <item name="android:minWidth">104dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:background">@drawable/bg_chip</item>
    </style>

    <!-- 开关：只有开关本体，文字由同行 TextView 承担 -->
    <style name="AtvSwitch" parent="android:Widget.DeviceDefault.CompoundButton.CheckBox">
        <item name="android:button">@drawable/bg_switch</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">@null</item>
    </style>
</resources>
