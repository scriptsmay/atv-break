<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AtvBreak" parent="android:Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- 主按钮：实心主色 -->
    <style name="AtvButton" parent="android:Widget.DeviceDefault.Button">
        <item name="android:minWidth">176dp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:background">@drawable/bg_button</item>
    </style>

    <!-- 次级按钮：描边幽灵按钮 -->
    <style name="AtvButton.Secondary">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>

    <!-- 预设胶囊 -->
    <style name="AtvChip" parent="android:Widget.DeviceDefault.Button">
        <item name="android:minWidth">104dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:background">@drawable/bg_chip</item>
    </style>

    <!--
      tab 项：文字 + 下划线指示，刻意不用胶囊背景。
      页内预设值是「实心胶囊 + 描边」，tab 是「纯文字 + 下划线」，两种形状不撞车。
    -->
    <style name="AtvTabItem">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="AtvTabLabel">
        <item name="android:textSize">22sp</item>
        <!-- 三个 tab 统一加粗：只让选中项加粗会在切换时改变文字宽度，整条 tab 栏左右跳动 -->
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tab_label</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="AtvTabUnderline">
        <item name="android:background">@drawable/bg_tab_underline</item>
    </style>

    <!-- 开关：只有开关本体，文字由同行 TextView 承担 -->
    <style name="AtvSwitch" parent="android:Widget.DeviceDefault.CompoundButton.CheckBox">
        <item name="android:button">@drawable/bg_switch</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:background">@null</item>
    </style>
</resources>
